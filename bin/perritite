#!/bin/sh
# Perritite launcher, shipped in the Claude Code plugin's bin/ (which Claude
# Code puts on PATH). It runs the perritite binary for this plugin's version:
# downloaded from the GitHub release on first use, cached, and checked on
# EVERY run against launcher/SHA256SUMS, which is committed in the plugin.
# A binary is only ever run if it matches the commit you installed.
# macOS, Linux, and Windows under Git Bash.
set -eu

die() {
	echo "perritite: $*" >&2
	exit 1
}

repo="chadrem/perritite"
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname "$here")
version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json" 2>/dev/null | head -n 1)
[ -n "$version" ] || die "no version in $root/.claude-plugin/plugin.json"

case "$(uname -s)" in
	Darwin) os=darwin ;;
	Linux) os=linux ;;
	MINGW* | MSYS* | CYGWIN* | *_NT*) os=windows ;;
	*) die "unsupported OS $(uname -s); install with: go install github.com/$repo@latest" ;;
esac
case "$(uname -m)" in
	x86_64 | amd64) arch=amd64 ;;
	arm64 | aarch64) arch=arm64 ;;
	*) die "unsupported CPU $(uname -m); install with: go install github.com/$repo@latest" ;;
esac
ext=""
[ "$os" = windows ] && ext=".exe"
asset="perritite-$os-$arch$ext"

want=$(awk -v a="$asset" '$2 == a || $2 == "*" a { print tolower($1); exit }' "$root/launcher/SHA256SUMS" 2>/dev/null)
[ -n "$want" ] || die "no checksum for $asset in $root/launcher/SHA256SUMS"
if command -v sha256sum >/dev/null 2>&1; then
	sha() { sha256sum <"$1" | awk '{print $1}'; } # stdin: no filename escaping
elif command -v shasum >/dev/null 2>&1; then
	sha() { shasum -a 256 <"$1" | awk '{print $1}'; }
else
	die "sha256sum or shasum is required to verify the binary"
fi

cache="${XDG_CACHE_HOME:-}"
case "$cache" in /*) ;; *) cache="$HOME/.cache" ;; esac # the XDG spec ignores relative paths
base="$cache/perritite"
dir="$base/bin/$version"
bin="$dir/$asset"
mkdir -p "$base" || die "cannot create $base"
# Nobody else may be able to write where the binary lives.
[ -O "$base" ] || die "$base is not owned by you; refusing to use it (fix: chown -R \"\$(id -un)\" \"$base\", or delete it)"
chmod 700 "$base" 2>/dev/null || true

if [ -f "$bin" ] && [ "$(sha "$bin")" = "$want" ]; then
	[ -x "$bin" ] || chmod +x "$bin" 2>/dev/null || :
	[ -x "$bin" ] && exec "$bin" "$@"
	rm -f "$bin" 2>/dev/null || : # can't make it runnable: replace it below
fi

# Missing, stale or tampered: (re)download and verify.
url="https://github.com/$repo/releases/download/v$version"
proto="--proto =https --proto-redir =https"
if [ -n "${PERRITITE_RELEASE_URL:-}" ]; then
	# A test hook, honoured only for a local server given exactly as
	# http://127.0.0.1:<port> or http://localhost:<port>. The committed
	# checksum is still enforced.
	port=""
	case "$PERRITITE_RELEASE_URL" in
		http://127.0.0.1:*) port=${PERRITITE_RELEASE_URL#http://127.0.0.1:} ;;
		http://localhost:*) port=${PERRITITE_RELEASE_URL#http://localhost:} ;;
	esac
	case "$port" in
		"" | *[!0-9]*) die "PERRITITE_RELEASE_URL must be exactly http://127.0.0.1:<port> or http://localhost:<port>" ;;
	esac
	url="$PERRITITE_RELEASE_URL/v$version"
	proto=""
fi
command -v curl >/dev/null 2>&1 || die "curl is required to download the perritite binary"
mkdir -p "$dir"
tmp=$(mktemp "$dir/.download.XXXXXX")
trap 'rm -f "$tmp"' EXIT
# shellcheck disable=SC2086 # $proto is deliberately split into flags
curl -fsSL --retry 3 $proto -o "$tmp" "$url/$asset" ||
	die "could not download $url/$asset: release v$version may not be published yet, or a network or proxy blocked it"
[ "$(sha "$tmp")" = "$want" ] || die "checksum mismatch for $asset; refusing to run it"
chmod +x "$tmp"
if ! mv -f "$tmp" "$bin" 2>/dev/null; then
	# A concurrent first run may have won (Windows can't replace a running
	# exe); fine, as long as what's there verifies.
	[ -f "$bin" ] && [ "$(sha "$bin")" = "$want" ] || die "could not install $bin"
fi
trap - EXIT
rm -f "$tmp"
exec "$bin" "$@"
